    STR_ZXI %2, %0, 2 :: (store (<vscale x 4 x s32>))
    HINT 0
    STR_ZXI %2, %0, 1 :: (store (<vscale x 4 x s32>))
    STR_ZXI %3, %0, 2 :: (store (<vscale x 4 x s32>))
    RET_ReallyLR
