# REQUIRES: asserts
# RUN: llc -mtriple=aarch64 -mattr=+sve2p1 -aarch64-enable-subreg-liveness-tracking -run-pass=aarch64-sve-load-store-clustering -debug-only=aarch64-sve-load-store-clustering %s -o /dev/null 2>&1 | FileCheck %s

---
name:            mixed_i64_i32_accesses
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: gpr64sp }
  - { id: 1, class: gpr64sp }
  - { id: 2, class: zpr }
  - { id: 3, class: zpr }
  - { id: 4, class: zpr }
  - { id: 5, class: zpr }
  - { id: 6, class: zpr }
  - { id: 7, class: zpr }
  - { id: 8, class: zpr }
  - { id: 9, class: zpr }
  - { id: 10, class: zpr }
  - { id: 11, class: zpr }
  - { id: 12, class: zpr }
  - { id: 13, class: zpr }
  - { id: 14, class: gpr64 }
  - { id: 15, class: gpr64 }
body:             |
  bb.0:
    %0:gpr64sp = IMPLICIT_DEF
    %1:gpr64sp = IMPLICIT_DEF
    %2:zpr = LDR_ZXI %0, 1 :: (load (<vscale x 1 x s128>))
    %3:zpr = LDR_ZXI %0, 0 :: (load (<vscale x 1 x s128>))
    %4:zpr = LDR_ZXI %0, 3 :: (load (<vscale x 1 x s128>))
    %5:zpr = LDR_ZXI %0, 2 :: (load (<vscale x 1 x s128>))
    %6:zpr = LDR_ZXI %0, 5 :: (load (<vscale x 1 x s128>))
    %7:zpr = LDR_ZXI %0, 4 :: (load (<vscale x 1 x s128>))
    %8:zpr = LDR_ZXI %0, 7 :: (load (<vscale x 1 x s128>))
    %9:zpr = LDR_ZXI %0, 6 :: (load (<vscale x 1 x s128>))
    STR_ZXI %2, %0, 1 :: (store (<vscale x 1 x s128>))
    STR_ZXI %3, %0, 0 :: (store (<vscale x 1 x s128>))
    STR_ZXI %4, %0, 3 :: (store (<vscale x 1 x s128>))
    STR_ZXI %5, %0, 2 :: (store (<vscale x 1 x s128>))
    STR_ZXI %6, %0, 5 :: (store (<vscale x 1 x s128>))
    STR_ZXI %7, %0, 4 :: (store (<vscale x 1 x s128>))
    STR_ZXI %8, %0, 7 :: (store (<vscale x 1 x s128>))
    STR_ZXI %9, %0, 6 :: (store (<vscale x 1 x s128>))
    %10:zpr = LDR_ZXI %1, 0 :: (load (<vscale x 1 x s128>))
    %14:gpr64 = IMPLICIT_DEF
    %11:zpr = LDR_ZXI %1, 1 :: (load (<vscale x 1 x s128>))
    %12:zpr = LDR_ZXI %1, 2 :: (load (<vscale x 1 x s128>))
    %13:zpr = LDR_ZXI %1, 3 :: (load (<vscale x 1 x s128>))
    STR_ZXI %10, %1, 0 :: (store (<vscale x 1 x s128>))
    %15:gpr64 = IMPLICIT_DEF
    STR_ZXI %11, %1, 1 :: (store (<vscale x 1 x s128>))
    STR_ZXI %12, %1, 2 :: (store (<vscale x 1 x s128>))
    STR_ZXI %13, %1, 3 :: (store (<vscale x 1 x s128>))
    RET_ReallyLR
...

# CHECK:      AArch64 SVE load cluster in bb.0: base %0, low offset 0, 8 instructions
# CHECK-NEXT:   offset-to-mi:
# CHECK-NEXT:     0: %3:zpr = LDR_ZXI %0:gpr64sp, 0 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     1: %2:zpr = LDR_ZXI %0:gpr64sp, 1 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     2: %5:zpr = LDR_ZXI %0:gpr64sp, 2 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     3: %4:zpr = LDR_ZXI %0:gpr64sp, 3 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     4: %7:zpr = LDR_ZXI %0:gpr64sp, 4 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     5: %6:zpr = LDR_ZXI %0:gpr64sp, 5 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     6: %9:zpr = LDR_ZXI %0:gpr64sp, 6 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     7: %8:zpr = LDR_ZXI %0:gpr64sp, 7 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT: AArch64 SVE store cluster in bb.0: base %0, low offset 0, 8 instructions
# CHECK-NEXT:   offset-to-mi:
# CHECK-NEXT:     0: STR_ZXI %3:zpr, %0:gpr64sp, 0 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     1: STR_ZXI %2:zpr, %0:gpr64sp, 1 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     2: STR_ZXI %5:zpr, %0:gpr64sp, 2 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     3: STR_ZXI %4:zpr, %0:gpr64sp, 3 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     4: STR_ZXI %7:zpr, %0:gpr64sp, 4 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     5: STR_ZXI %6:zpr, %0:gpr64sp, 5 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     6: STR_ZXI %9:zpr, %0:gpr64sp, 6 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     7: STR_ZXI %8:zpr, %0:gpr64sp, 7 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT: AArch64 SVE load cluster in bb.0: base %1, low offset 0, 4 instructions
# CHECK-NEXT:   offset-to-mi:
# CHECK-NEXT:     0: %10:zpr = LDR_ZXI %1:gpr64sp, 0 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     1: %11:zpr = LDR_ZXI %1:gpr64sp, 1 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     2: %12:zpr = LDR_ZXI %1:gpr64sp, 2 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT:     3: %13:zpr = LDR_ZXI %1:gpr64sp, 3 :: (load (<vscale x 1 x s128>))
# CHECK-NEXT: AArch64 SVE store cluster in bb.0: base %1, low offset 0, 4 instructions
# CHECK-NEXT:   offset-to-mi:
# CHECK-NEXT:     0: STR_ZXI %10:zpr, %1:gpr64sp, 0 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     1: STR_ZXI %11:zpr, %1:gpr64sp, 1 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     2: STR_ZXI %12:zpr, %1:gpr64sp, 2 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     3: STR_ZXI %13:zpr, %1:gpr64sp, 3 :: (store (<vscale x 1 x s128>))

---
name:            cluster_boundaries
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: gpr64sp }
  - { id: 1, class: gpr64sp }
  - { id: 2, class: zpr }
  - { id: 3, class: zpr }
  - { id: 4, class: zpr }
  - { id: 5, class: zpr }
  - { id: 6, class: zpr }
  - { id: 7, class: zpr }
body:             |
  bb.0:
    %0:gpr64sp = IMPLICIT_DEF
    %1:gpr64sp = IMPLICIT_DEF
    %5:zpr = IMPLICIT_DEF
    %6:zpr = IMPLICIT_DEF
    %7:zpr = IMPLICIT_DEF

    ; A single instruction is not a cluster.
    %2:zpr = LDR_ZXI %0, 0 :: (load (<vscale x 1 x s128>))
    HINT 0

    ; The offsets contain a gap.
    %3:zpr = LDR_ZXI %0, 0 :: (load (<vscale x 1 x s128>))
    %4:zpr = LDR_ZXI %0, 2 :: (load (<vscale x 1 x s128>))
    HINT 0

    ; A duplicate ends the current candidate and begins a new candidate.
    STR_ZXI %5, %0, 0 :: (store (<vscale x 1 x s128>))
    STR_ZXI %6, %0, 0 :: (store (<vscale x 1 x s128>))
    STR_ZXI %6, %0, 1 :: (store (<vscale x 1 x s128>))
    STR_ZXI %7, %0, 2 :: (store (<vscale x 1 x s128>))
    HINT 0

    ; Different base registers do not form a cluster.
    STR_ZXI %6, %0, 0 :: (store (<vscale x 1 x s128>))
    STR_ZXI %7, %1, 1 :: (store (<vscale x 1 x s128>))
    RET_ReallyLR
...

# CHECK:      AArch64 SVE store cluster in bb.0: base %0, low offset 0, 3 instructions
# CHECK-NEXT:   offset-to-mi:
# CHECK-NEXT:     0: STR_ZXI %6:zpr, %0:gpr64sp, 0 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     1: STR_ZXI %6:zpr, %0:gpr64sp, 1 :: (store (<vscale x 1 x s128>))
# CHECK-NEXT:     2: STR_ZXI %7:zpr, %0:gpr64sp, 2 :: (store (<vscale x 1 x s128>))
# CHECK-NOT: AArch64 SVE
