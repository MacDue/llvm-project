entry:
  %vscale = call i64 @llvm.vscale.i64()
  %vector.width = shl nuw i64 %vscale, 4
  %vector.offset = shl nuw i64 %vscale, 2
  br label %loop

loop:
  %index = phi i64 [ 0, %entry ], [ %index.next, %loop ]
  %ptr.0 = getelementptr inbounds i64, ptr %base, i64 %index
  %offset.2 = shl nuw i64 %vector.offset, 1
  %offset.3 = mul nuw i64 %vector.offset, 3
  %ptr.1 = getelementptr inbounds i64, ptr %ptr.0, i64 %vector.offset
  %ptr.2 = getelementptr inbounds i64, ptr %ptr.0, i64 %offset.2
  %ptr.3 = getelementptr inbounds i64, ptr %ptr.0, i64 %offset.3
  %value.0 = load <vscale x 4 x i64>, ptr %ptr.0, align 8
  %value.1 = load <vscale x 4 x i64>, ptr %ptr.1, align 8
  %value.2 = load <vscale x 4 x i64>, ptr %ptr.2, align 8
  %value.3 = load <vscale x 4 x i64>, ptr %ptr.3, align 8
