// RUN: llvm-tblgen -gen-intrinsic-feature-checks \
// RUN:   -intrinsic-feature-prefix=test -intrinsic-feature-namespace=TestTarget \
// RUN:   -I %p/../../include %s | FileCheck %s

// A TargetGuard without overload types applies to every valid overload.
// A target can define its own feature enum namespace.
// The generated table is also compiled by IntrinsicFeatureEmitterTest.
// CHECK:      // Generated by -gen-intrinsic-feature-checks.
// CHECK-NEXT: namespace llvm {
// CHECK-EMPTY:
// CHECK-NEXT: static constexpr FeatureBitset TestTargetIntrinsicFeatureClauses[] = {
// CHECK-NEXT:   {TestTarget::FeatureExample},
// CHECK-NEXT:   {TestTarget::FeatureOther},
// CHECK-NEXT:   {TestTarget::FeatureOther},
// CHECK-NEXT: };
// CHECK-EMPTY:
// CHECK-NEXT: static constexpr MVT::SimpleValueType TestTargetIntrinsicOverloadTypes[] = {
// CHECK-NEXT:   // int_test_one_guard
// CHECK-NEXT:   // int_test_two_guards
// CHECK-NEXT:   MVT::i32, // int_test_type_specific_guards
// CHECK-NEXT:   MVT::i64, // int_test_type_specific_guards
// CHECK-NEXT:   // int_test_typed
// CHECK-NEXT: };
// CHECK-EMPTY:
// CHECK-NEXT: static constexpr unsigned TestTargetIntrinsicGuardIndices[] = {
// CHECK-NEXT:   0, // int_test_one_guard
// CHECK-NEXT:   0, 1, // int_test_two_guards
// CHECK-NEXT:   0, 2, // int_test_type_specific_guards
// CHECK-NEXT:   1, 0, // int_test_type_specific_guards
// CHECK-NEXT:   0, // int_test_typed
// CHECK-NEXT: };
// CHECK-EMPTY:
// CHECK-NEXT: static constexpr IntrinsicFeatureGuard TestTargetIntrinsicFeatureGuards[] = {
// CHECK-NEXT:   {0, 1, "example", "", 0, {}},
// CHECK-NEXT:   {1, 1, "other", "conditional", 1, {TestTarget::FeatureOther}},
// CHECK-NEXT:   {2, 1, "other", "", 0, {}},
// CHECK-NEXT: };
// CHECK-EMPTY:
// CHECK-NEXT: class TestTargetGuardedIntrinsicInfo final : public GuardedIntrinsicInfo {
// CHECK-NEXT:   bool checkGuardPredicate(
// CHECK-NEXT:       const IntrinsicFeatureGuard &Guard,
// CHECK-NEXT:       const TargetSubtargetInfo &STI) const override {
// CHECK-NEXT:     const TestTargetSubtarget &ST =
// CHECK-NEXT:         static_cast<const TestTargetSubtarget &>(STI);
// CHECK-NEXT:     switch (Guard.Index) {
// CHECK-NEXT:     case 0:
// CHECK-NEXT:       return (true);
// CHECK-NEXT:     case 1:
// CHECK-NEXT:       return (ST.Enabled);
// CHECK-NEXT:     default: return false;
// CHECK-NEXT:     }
// CHECK-NEXT:   }
// CHECK:      static constexpr IntrinsicFeatureVariant TestTargetIntrinsicVariants[] = {
// CHECK-NEXT:   {0, 0, 0, 1}, // int_test_one_guard
// CHECK-NEXT:   {0, 0, 1, 2}, // int_test_two_guards
// CHECK-NEXT:   {0, 1, 3, 2}, // int_test_type_specific_guards
// CHECK-NEXT:   {1, 1, 5, 2}, // int_test_type_specific_guards
// CHECK-NEXT:   {2, 0, 7, 1}, // int_test_typed
// CHECK-NEXT: };
// CHECK-EMPTY:
// CHECK-NEXT: static constexpr GuardedIntrinsicEntry TestTargetIntrinsicEntries[] = {
// CHECK-NEXT:   {Intrinsic::test_one_guard, 0, 1},
// CHECK-NEXT:   {Intrinsic::test_two_guards, 1, 1},
// CHECK-NEXT:   {Intrinsic::test_type_specific_guards, 2, 2},
// CHECK-NEXT:   {Intrinsic::test_typed, 4, 1},
// CHECK-NEXT: };
// CHECK-EMPTY:
// CHECK-NEXT: TestTargetGuardedIntrinsicInfo::TestTargetGuardedIntrinsicInfo()
// CHECK-NEXT:     : GuardedIntrinsicInfo("TestTarget", TestTargetIntrinsicFeatureClauses,
// CHECK-NEXT:           TestTargetIntrinsicOverloadTypes, TestTargetIntrinsicGuardIndices,
// CHECK-NEXT:           TestTargetIntrinsicFeatureGuards, TestTargetIntrinsicVariants,
// CHECK-NEXT:           TestTargetIntrinsicEntries) {}
// CHECK-EMPTY:
// CHECK-NEXT: {{\[\[maybe_unused\]\]}} static const GuardedIntrinsicInfo &getTestTargetGeneratedGuardedIntrinsicInfo() {
// CHECK-NEXT:   static const TestTargetGuardedIntrinsicInfo Info;
// CHECK-NEXT:   return Info;
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: } // namespace llvm

include "llvm/IR/Intrinsics.td"
include "llvm/Target/TargetSubtarget.td"

def FeatureExample : SubtargetFeature<"example", "Example", "true", "">;
def FeatureOther : SubtargetFeature<"other", "Other", "true", "">;

class ConditionalGuard<string features> : FeatureGuard<features> {
  let Name = "conditional";
  let Predicate = [{ST.Enabled}];
  let ImpliedFeatures = "other";
}

let TargetPrefix = "test" in
def int_test_one_guard
    : GuardedDefaultIntrinsic<[llvm_anyint_ty], [LLVMMatchType<0>],
                              [IntrNoMem]> {
  let TargetGuards = [GuardedVariant<[FeatureGuard<"example">]>];
}

let TargetPrefix = "test" in
def int_test_two_guards
    : GuardedDefaultIntrinsic<[llvm_anyint_ty], [LLVMMatchType<0>],
                              [IntrNoMem]> {
  let TargetGuards =
      [GuardedVariant<[FeatureGuard<"example">, ConditionalGuard<"other">]>];
}

let TargetPrefix = "test" in
def int_test_type_specific_guards
    : GuardedDefaultIntrinsic<[llvm_anyint_ty], [LLVMMatchType<0>],
                              [IntrNoMem]> {
  let TargetGuards = [
      GuardedVariant<[FeatureGuard<"example">, FeatureGuard<"other">],
                     [[llvm_i32_ty]]>,
      GuardedVariant<[ConditionalGuard<"other">, FeatureGuard<"example">],
                     [[llvm_i64_ty]]>];
}

let TargetPrefix = "test" in
def int_test_typed
    : GuardedDefaultIntrinsic<[llvm_i32_ty], [llvm_i32_ty], [IntrNoMem]> {
  let TargetGuards = [GuardedVariant<[FeatureGuard<"example">], [[]<LLVMType>]>];
}
